#!/usr/bin/env php
<?php
/**
 * Spotpreis Tibber - Anschluss an den LoxBerry-Healthcheck (Form seit 0.9.33, Gruppe 43, nach Renault NG 2.1.20)
 *
 * sbin/healthcheck.pl ruft eine ausfuehrbare Datei bin/healthcheck des Plugins auf - einmal mit "title", einmal mit
 * "check" (Regeln/03 :73-78, Regeln/04 :809). Beide Antworten sind JSON:
 *   title -> {"desc":"Spotpreis Tibber"}
 *   check -> {"desc", "status", "result", "logfile"}; Status 3 Fehler, 4 Warnung, 5 in Ordnung, 6 Hinweis.
 *
 * NUR LESEND: kein Netz, kein Broker, kein Abruf bei Tibber, keine Datei. Geurteilt wird ueber das ALTER
 * (Lebenszeichen des Minutenlaufs, letzter gelungener Abruf), nie ueber einen einzelnen Abruf - die Fakten sammelt
 * tb_gesund_fakten(), das Urteil faellt die reine Funktion tb_gesund_urteil() (beide in tb_lib.php):
 *   - kein Tibber-Token -> 6 "nicht eingerichtet" (eine Neuinstallation ist kein Fehler; bis 0.9.32: 3);
 *   - Lebenszeichen (data/plugins/<ordner>/zaehler) aelter als 10 min -> 3 (neu: der Minutenlauf steht);
 *   - letzter gelungener Abruf aelter als die Altersschranke -> 3 mit Fehlertext, sonst 4; noch nie -> 4;
 *   - Konfiguration nicht 0600 -> 4; Pulse soll laufen, laeuft nicht -> 4;
 *   - Gateway V2: Haken fehlen -> 4 mit Namen (Gateway V1: keine Aussage);
 *   - Anbieter haus/strompreis gescheitert (Broker, schweigender gewaehlter Anbieter) -> 4.
 * Aufruf wie LoxBerry: direkt, als loxberry, Eingabe aus /dev/null. Der Installer setzt bin/ 755. Diese Datei ist
 * PHP mit Shebang - nie mit /bin/bash aufrufen.
 */

error_reporting(E_ALL & ~E_DEPRECATED & ~E_NOTICE);
ini_set('display_errors', '0');

function tb_hc_ausgeben(array $felder)
{
    $json = json_encode($felder, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
    if ($json === false) {
        $json = '{"desc":"Spotpreis Tibber","status":3,"result":"Der Befund liess sich nicht als JSON verpacken."}';
    }
    echo $json . "\n";
}

$tb_was = isset($argv[1]) ? strtolower((string) $argv[1]) : 'check';
if ($tb_was === 'title') {
    tb_hc_ausgeben(array('desc' => 'Spotpreis Tibber'));
    exit(0);
}

/* Die Bibliothek: welche Lage gilt, entscheidet der eigene Ablageort (wie bin/tb_cron.php). */
if (basename(dirname(__DIR__)) === 'plugins' && basename(dirname(dirname(__DIR__))) === 'bin') {
    $tb_kandidat = dirname(dirname(dirname(__DIR__))) . '/webfrontend/html/plugins/' . basename(__DIR__) . '/tb_lib.php';
} else {
    $tb_kandidat = dirname(__DIR__) . '/webfrontend/html/tb_lib.php';
}
if (!is_file($tb_kandidat)) {
    tb_hc_ausgeben(array('desc' => 'Spotpreis Tibber', 'status' => 3,
        'result' => 'Die Bibliothek tb_lib.php wurde nicht gefunden - das Plugin ist unvollstaendig installiert.'));
    exit(0);
}
require_once $tb_kandidat;

$tb_hc_p = tb_paths();
if ($tb_hc_p['home'] === '') {
    tb_hc_ausgeben(array('desc' => 'Spotpreis Tibber', 'status' => 3,
        'result' => 'Kein LoxBerry-Wurzelverzeichnis gefunden (ausgepacktes Archiv oder Pruefordner) - nichts geprueft.'));
    exit(0);
}

list($tb_status, $tb_text) = tb_gesund_urteil(tb_gesund_fakten(tb_config(false)));
tb_hc_ausgeben(array(
    'desc'    => 'Spotpreis Tibber',
    'status'  => (int) $tb_status,
    'result'  => (string) $tb_text,
    'logfile' => $tb_hc_p['log'],
));
exit(0);
